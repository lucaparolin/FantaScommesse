<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gioco di pronostici tra amici sulla Serie A" />
    <meta name="theme-color" content="#1a73e8" />
    <title>@ViewData["Title"] - FantaScommesse</title>

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png" />
    <link rel="apple-touch-icon" href="/images/icon-192.png" />

    <!-- Styles -->
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <!-- Network status indicator -->
    <div id="network-status" role="status" aria-live="polite"></div>

    <!-- Header -->
    <header class="header" role="banner">
        <div class="container">
            <h1>⚽ FantaScommesse</h1>
            <nav class="nav" role="navigation" aria-label="Navigazione principale">
                <a href="/">Home</a>
                <a href="/predictions">Pronostici</a>
                <a href="/scoreboard">Classifica</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/account">Account</a>
                    <a href="/auth/logout">Esci</a>
                }
                else
                {
                    <a href="/auth/login">Accedi</a>
                    <a href="/auth/register">Registrati</a>
                }
            </nav>
        </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="main" role="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer" role="contentinfo">
        <div class="container">
            <p>&copy; @DateTime.UtcNow.Year FantaScommesse. Tutti i diritti riservati.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- PWA Install Button (hidden by default) -->
    <button id="install-button" class="btn btn-primary" style="display: none; position: fixed; bottom: 20px; right: 20px; z-index: 1000;">
        Installa App
    </button>
</body>
</html>
